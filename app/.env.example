# Claude API キー（必須）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 永久マスターコード（任意・自分のテスト用にも使える。買い切りは/adminで発行推奨）
UNLOCK_CODE=お好きな合言葉に変更

# コード発行ページ(/admin)の管理パスワード（月額/買い切りコードを発行するのに必須）
ADMIN_KEY=推測されにくい管理パスワードに変更

# 署名鍵（任意・未設定なら UNLOCK_CODE を流用）
# UNLOCK_SECRET=長めのランダム文字列

# Stripeのシークレットキー（決済後の自動コード発行に必要）
# Stripeダッシュボード → 開発者 → APIキー の「シークレットキー(sk_live_...)」
STRIPE_SECRET_KEY=sk_live_xxxxxxxx

# Stripe Webhook署名シークレット（月額の翌月自動更新→メール送信に必要）
# Stripeダッシュボード → 開発者 → Webhook → エンドポイント作成後に表示される(whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend APIキー（自動更新コードのメール送信に必要）
# https://resend.com → API Keys で発行(re_...)
RESEND_API_KEY=re_xxxxxxxx

# メール送信元（Resendで認証したドメインのアドレス推奨）
# 例: 副業ドラフト <no-reply@zizi.ly>  ／ 未設定なら resend.dev のテスト送信元を使用
MAIL_FROM=副業ドラフト <no-reply@あなたのドメイン>

# ===== Threads 自動投稿（拡散用・自分のアカウントへ）=====
# Threads長期アクセストークン（Meta開発者アプリで取得。60日ごと更新）
THREADS_ACCESS_TOKEN=THAAxxxxxxxx
# 自分のThreadsユーザーID（未設定なら "me" を使用）
THREADS_USER_ID=
# tickを叩くための合言葉（cron-job.org 等で使用。推測されにくい文字列に）
CRON_KEY=推測されにくい合言葉に変更
# 投稿開始日時 ISO（例: 2026-07-17T08:00:00+09:00）。未設定なら初回tick時刻が起点
THREADS_START=
# 投稿間隔（時間）。8=1日3本、6=1日4本、4=1日6本、12=1日2本
THREADS_INTERVAL_HOURS=8
# 静音時間帯（JST・この時間帯は投稿しない）。既定 1〜6時。無効化は同じ値に
THREADS_QUIET_START=1
THREADS_QUIET_END=6

# サーバーポート（デフォルト: 4000）
PORT=4000
