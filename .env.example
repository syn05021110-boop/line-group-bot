# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Google Sheets（line-group-bot 管理スプシ）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPREADSHEET_ID=

# 管理者の LINE ユーザーID（Bot が無視する対象）
ADMIN_USER_ID=

# サーバー設定
PORT=3000

# DMM/FANZA Web Service API（アフィリエイト投稿生成用）
# 取得: https://affiliate.dmm.com/api/
DMM_API_ID=
DMM_AFFILIATE_ID=

# X (Twitter) API v2 — 自動投稿用（Basic プラン以上が必要 / $100/mo）
# 取得: https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 自動投稿デーモン設定（オプション）
POST_INTERVAL_HOURS=4        # 投稿間隔（短いほど凍結リスク↑）
GENERATE_INTERVAL_HOURS=24   # 候補生成間隔
POSTS_PER_GENERATION=10      # 1回の生成サイクルで作る候補数
